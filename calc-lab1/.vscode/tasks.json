{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-O2",
                "-Wall",
                "-Wextra",
                "-std=c17",
                "-o",
                "calc",
                "src/calc.c",
                "-lm"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Compiles the calculator program."
        },
        {
            "label": "run",
            "type": "shell",
            "command": "./calc",
            "group": "test",
            "dependsOn": "build",
            "problemMatcher": []
        }
    ]
}